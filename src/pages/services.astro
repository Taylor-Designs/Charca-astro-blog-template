  ---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Taylor Designs services';
const description = 'Available design services.';
const permalink = `${Astro.site.href}services`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="services">
  <div class="container">
   <h1>Services</h1>
     <h2>Logo Designs</h2>
        <p>Logo design options include:</p>
            <ul>
                <li>Logomark $250</li>
                <li>Wordmark $250</li>
                <li>Combination $500</li>
                <li>Logo Restoration $150</li>
            </ul>
     <h2>Flyer Designs</h2>
        <p>Custom flier designs to help you advertise events, get the word out about your services, or anything else you can think of to put on a flier!</p>
         <p>Flier design options include:</p>
            <ul>
                <li>Basic Flier $100</li>
                <li>Custom Basic Flier $150</li>
                <li>Custom Illustrated Flier $200</li>
            </ul>
     <h2>Patterns</h2>
            <h3>Pattern Design: 150</h3>
                <p>A tileable pattern design in black on white/ white on black, and up to 3 pairs of brand color combinations (ex. light blue on white/ white on light blue).</p>
           <h3>additional color combibinations: $10</h3>
                <p>Adds one extra pair of color combinations to your chosen pattern design.</p>

  </div>
</BaseLayout>

