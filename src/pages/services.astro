  ---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Taylor Designs services';
const description = 'Available design services.';
const permalink = `${Astro.site.href}services`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="services">
  <div class="container">
   <h1>Services</h1>
            <ul>
                <li>Logos</li>
                <li>Fliers</li>
                <li>Patterns</li>
            </ul>
     <h2>Logo Designs</h2>
        <p>Logo design options include:</p>
                <h3>Logomark $250</h3>
                    <p>Logomarks are great for getting a basic visual in the minds of consumers that they will eventually automatically associate with your brand</p>
                <h3>Wordmark $250</h3>
                    <p>A wordmark is a great choice for a brand that wants people to know its name from the start.</p>
                <h3>Combination $500</h3>
                    <p>The best of both worlds! Get both a Logomark and Wordmark as well as a design combining them both! This will help your brand stand out from the crowd and allow for more applications of your logo depending on the circumstances.</p>
                <h3>Logo Restoration $150</h3>
                    <p>Restore a logo from a pixel based file format like PNG or JPEG to a Vector design that can be scaled without loosing quality.</p>
     <h2>Flyer Designs</h2>
        <p>Custom flier designs to help you advertise events, get the word out about your services, or anything else you can think of to put on a flier!</p>
         <p>Flier design options include:</p>
             <h3>Basic Flier $100</h3>
                <p>A flier/ advertisement designed only using graphics and fonts provided by the customer.</p>
             <h3>Custom Basic Flier $150</h3>
                <p>A flier/ advertisement designed using provided logos and fonts with additional custom designed graphics!</p>
            <h3>Custom Illustrated Flier $200</h3>
                <p>A flier/ advertisement designed using provided logos and fonts with a fully illustrated background to help it stand out from the crowd!</p>
     <h2>Patterns</h2>
                <p></p>
           <h3>Pattern Design: 150</h3>
              <p>A tileable pattern design in black on white/ white on black, and up to 3 pairs of brand color combinations (ex. light blue on white/ white on light blue).</p>
          <h3>additional color combibinations: $10</h3>
              <p>Adds one extra pair of color combinations to your chosen pattern design.</p>

  </div>
</BaseLayout>

