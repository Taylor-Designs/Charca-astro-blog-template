---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';

const title = 'About';
const description = 'About your blog.';
const permalink = `${Astro.site.href}about`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="container">
    <h1>关于我</h1>
    <figure class="about-image">
      <img src={`${config.imageBaseUrl}about-illustration.png`} alt="Illustration of a notebook" width="330">
      <figcaption>
        Illustration by
        <a href="https://icons8.com/illustrations/author/5c07e68d82bcbc0092519bb6" target="_blank" rel="noopener">Icons 8</a>
        from
        <a href="https://icons8.com/illustrations" target="_blank" rel="noopener">Ouch!</a>
      </figcaption>
    </figure>

    <section class="site-intro">
      <h2>欢迎来到SAP学习中心</h2>
      <p>这是一个SAP学习者建立的交流网站，记录了我在SAP学习过程中的经验与问题。
        如果你有任何问题或建议，请欢迎留言交流。</p>
        <p>
        我在SAP学习过程中，遇到了许多问题，也学习了许多新的知识。
        我希望与你分享这些经验，也欢迎你与我交流。
        </p>
        <p>
        如果你想投稿到本网站也可以通过下面的邮箱发给我。
        </p>
      <p>我们的邮箱是<a href="mailto:admin@sapehr.cn">admin@sapehr.cn</a>。
      </p>
    </section>

  </div>
</BaseLayout>

<style>
  .about-image {
    float: right;
    margin: -3em -7em 2em 2em;
    max-width: 300px;
  }

  .about-image img {
    border-radius: 8px;
    margin-bottom: 1.5em;
  }

  @media (max-width: 1020px) {
    .about-image {
      float: none;
      margin: 0 auto 2em;
    }
  }
</style>
