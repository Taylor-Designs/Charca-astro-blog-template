---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Checkout';
const description = 'Taylor Designs checkout page.';
const permalink = `${Astro.site.href}checkout`;
---
<BaseLayout title={title} description={description} permalink={permalink} current="checkout">
  <div class="container">
    <h1>Checkout</h1>
        <a Paddle.Checkout.open({ items, customer: { email } }) checkout> </a>
</div>
</BaseLayout>
